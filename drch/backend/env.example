# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/disaster_management

# Social Media API Keys (FREE alternatives)
YOUTUBE_API_KEY=your_youtube_api_key_here
NEWS_API_KEY=your_news_api_key_here
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here  # Expensive - $100/month for basic tier

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Django Configuration
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google Maps API Key (for frontend)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Weather API Key (for Phase 2)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# GDACS API (for Phase 3)
GDACS_API_KEY=your_gdacs_api_key_here
